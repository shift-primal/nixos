         Guid[] linkedChildAncestorIds = [];
 
         includeItemTypes ??= [];
+
+        // Search finds films and series, not episodes or people: with Gelato's catalogs in the
+        // library, episode titles and cast names matched almost any word and buried the shows.
+        if (!string.IsNullOrWhiteSpace(searchTerm))
+        {
+            BaseItemKind[] hidden = [BaseItemKind.Episode, BaseItemKind.Person];
+            if (includeItemTypes.Length != 0 && includeItemTypes.All(hidden.Contains))
+            {
+                return new QueryResult<BaseItemDto>();
+            }
+
+            excludeItemTypes = [.. excludeItemTypes, .. hidden];
+            includeItemTypes = [.. includeItemTypes.Except(hidden)];
+        }
+
         if (includeItemTypes.Length == 1
             && (includeItemTypes[0] == BaseItemKind.BoxSet || includeItemTypes[0] == BaseItemKind.Playlist)
             && item is not BoxSet
