output "HP Inc. HP S270n 6CM9131QL2" {
    mode "2560x1440"
    scale 1
    position x=0 y=0
}

output "PNP(AOC) Q27G4ZR XZ1S1HA010862" {
    mode "2560x1440"
    scale 1
    position x=2560 y=0
