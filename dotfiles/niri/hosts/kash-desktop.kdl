}

output "HP Inc. OMEN by HP 27 #ASN/n8z9QTPd" {
    mode "2560x1440"
    scale 1
    position x=5120 y=0
}

workspace "1" {
    open-on-output "HP Inc. HP S270n 6CM9131QL2"
}
workspace "2" {
    open-on-output "PNP(AOC) Q27G4ZR XZ1S1HA010862"
}
workspace "3" {
    open-on-output "HP Inc. OMEN by HP 27 #ASN/n8z9QTPd"
}
workspace "4" {
    open-on-output "PNP(AOC) Q27G4ZR XZ1S1HA010862"
}
workspace "5" {
    open-on-output "PNP(AOC) Q27G4ZR XZ1S1HA010862"
}

