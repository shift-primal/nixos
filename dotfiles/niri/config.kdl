// Values owned by ~/nixos/vars.nix (keyboard, cursor, default-app binds) and the per-machine file
// hosts/<hostname>.kdl come from ~/.config/nixos-vars/niri.kdl, generated by modules/desktop/niri.nix.

input {
    keyboard {
        repeat-delay 250
        repeat-rate 30
        numlock
    }

    mouse {
        accel-profile "flat"
        accel-speed -0.2
    }

    touchpad {
        tap
        natural-scroll
        click-method "clickfinger"
        accel-profile "flat"
        accel-speed -0.2
    }

    focus-follows-mouse max-scroll-amount="0%"
}

layout {
    gaps 12
    center-focused-column "never"
    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        width 2
    }

    shadow {
        on
        softness 4
        spread 0
        offset x=0 y=0
    }
}

blur {
    passes 2
    offset 3
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

spawn-at-startup "noctalia"
spawn-sh-at-startup "wl-paste --type text --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"
spawn-sh-at-startup "wl-clip-persist --clipboard regular"

animations {
    window-open {
        duration-ms 500
        curve "cubic-bezier" 0.18 0.95 0.22 1.03
    }
    window-close {
        duration-ms 300
        curve "cubic-bezier" 0.18 0.95 0.22 1.03
    }
    window-movement {
        duration-ms 300
        curve "cubic-bezier" 0.18 0.95 0.22 1.03
    }
    window-resize {
        duration-ms 300
        curve "cubic-bezier" 0.18 0.95 0.22 1.03
    }
    horizontal-view-movement {
        duration-ms 300
        curve "cubic-bezier" 0.18 0.95 0.22 1.03
    }
    workspace-switch {
        duration-ms 400
        curve "cubic-bezier" 0.18 0.95 0.22 1.03
    }
}

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
    background-effect {
        blur true
    }
}

window-rule {
    match app-id="^net-runelite-client-RuneLite$" title="^win[0-9]+$"
    open-focused false
}

window-rule {
    match app-id="^jetbrains-.*$" title="^Welcome to JetBrains.*$"
    open-floating true
}

window-rule {
    match title="^Picture[- ]in[- ][Pp]icture$"
    open-floating true
    default-column-width { proportion 0.25; }
    default-window-height { proportion 0.25; }
    default-floating-position x=32 y=32 relative-to="bottom-right"
}

window-rule {
    match app-id="^Bitwarden$"
    block-out-from "screencast"
}

layer-rule {
    match namespace="^noctalia-background-"
    background-effect {
        blur true
    }
    popups {
        background-effect {
            blur true
        }
    }
}

binds {
    Mod+Space repeat=false hotkey-overlay-title="Noctalia launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Escape repeat=false hotkey-overlay-title="Noctalia control center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Comma repeat=false hotkey-overlay-title="Noctalia settings panel" { spawn "noctalia" "msg" "settings-toggle"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute repeat=false allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    Mod+Alt+Left repeat=false allow-when-locked=true hotkey-overlay-title="Previous song" { spawn "noctalia" "msg" "media" "previous"; }
    Mod+Alt+Right repeat=false allow-when-locked=true hotkey-overlay-title="Next song" { spawn "noctalia" "msg" "media" "next"; }
    Mod+Alt+Space repeat=false allow-when-locked=true hotkey-overlay-title="Play/pause song" { spawn "noctalia" "msg" "media" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    Mod+Shift+S repeat=false hotkey-overlay-title="Screen toolkit panel" { spawn "noctalia" "msg" "plugin" "alexander/screen-toolkit:service" "all" "toggle"; }
    Mod+S repeat=false hotkey-overlay-title="Screenshot region" { spawn "noctalia" "msg" "screenshot-region"; }
    Mod+R repeat=false hotkey-overlay-title="Record region" { spawn "noctalia" "msg" "plugin" "noctalia/screen_recorder:service" "all" "toggle" "region"; }

    Mod+Ctrl+L repeat=false hotkey-overlay-title="Lock computer" { spawn "noctalia" "msg" "session" "lock"; }
    Ctrl+Alt+Delete repeat=false hotkey-overlay-title="Power menu" { spawn "noctalia" "msg" "panel-toggle" "session"; }

    // niri cannot send a shortcut to a window itself (Hyprland's send_shortcut); wtype types it instead.
    Mod+C repeat=false hotkey-overlay-title="Universal copy" { spawn "wtype" "-M" "ctrl" "-k" "Insert" "-m" "ctrl"; }
    Mod+V repeat=false hotkey-overlay-title="Universal paste" { spawn "wtype" "-M" "shift" "-k" "Insert" "-m" "shift"; }
    Mod+X repeat=false hotkey-overlay-title="Universal cut" { spawn "wtype" "-M" "ctrl" "-k" "x" "-m" "ctrl"; }
    Mod+Y repeat=false hotkey-overlay-title="Clipboard history" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }

    Mod+B repeat=false hotkey-overlay-title="Keybind cheatsheet" { spawn "noctalia" "msg" "panel-toggle" "kenn/keybind-cheatsheet:cheatsheet"; }
    Mod+Shift+C repeat=false hotkey-overlay-title="Color picker" { spawn "noctalia" "msg" "plugin" "alexander/screen-toolkit:service" "all" "colorPicker"; }
    Mod+M repeat=false hotkey-overlay-title="Measure screen" { spawn "noctalia" "msg" "plugin" "alexander/screen-toolkit:service" "all" "measure"; }

    Mod+W repeat=false hotkey-overlay-title="Close focused window (not in WoW)" {
        spawn-sh r#"niri msg --json focused-window | jq -e '(.app_id // "" | ascii_downcase) == "wow.exe" or .title == "World of Warcraft"' >/dev/null || niri msg action close-window"#
    }
    Mod+T repeat=false hotkey-overlay-title="Toggle floating" { toggle-window-floating; }
    Mod+F repeat=false hotkey-overlay-title="Toggle fullscreen" { fullscreen-window; }
    Mod+Shift+F repeat=false hotkey-overlay-title="Maximize column" { maximize-column; }

    Mod+Left { focus-column-or-monitor-left; }
    Mod+Right { focus-column-or-monitor-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+H { focus-column-or-monitor-left; }
    Mod+L { focus-column-or-monitor-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }

    Mod+Shift+Left { move-column-left-or-to-monitor-left; }
    Mod+Shift+Right { move-column-right-or-to-monitor-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+H { move-column-left-or-to-monitor-left; }
    Mod+Shift+L { move-column-right-or-to-monitor-right; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+J { move-window-down; }

    Mod+G hotkey-overlay-title="Stack into / out of the column on the left" { consume-or-expel-window-left; }
    Mod+Minus hotkey-overlay-title="Narrower column" { set-column-width "-10%"; }
    Mod+Equal hotkey-overlay-title="Wider column" { set-column-width "+10%"; }
    Mod+O repeat=false hotkey-overlay-title="Overview" { toggle-overview; }

    Mod+1 { focus-workspace "1"; }
    Mod+2 { focus-workspace "2"; }
    Mod+3 { focus-workspace "3"; }
    Mod+4 { focus-workspace "4"; }
    Mod+5 { focus-workspace "5"; }
    Mod+Shift+1 { move-window-to-workspace "1"; }
    Mod+Shift+2 { move-window-to-workspace "2"; }
    Mod+Shift+3 { move-window-to-workspace "3"; }
    Mod+Shift+4 { move-window-to-workspace "4"; }
    Mod+Shift+5 { move-window-to-workspace "5"; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }

    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}

include "~/.config/nixos-vars/niri.kdl"

include optional=true "noctalia.kdl"
