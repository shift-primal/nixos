" IdeaVim config for Rider. Linked to ~/.config/ideavim/ideavimrc by home.nix.

" y/p use the system clipboard
set clipboard+=unnamedplus

" Ctrl+S goes to Rider (Save All) in every mode
sethandler <C-s> a:ide

" Alt+j / Alt+k move the line (or selection) down / up
" <Action>(...) only runs from recursive maps (nmap, not nnoremap)
sethandler <A-j> a:vim
sethandler <A-k> a:vim
nmap <A-j> <Action>(MoveLineDown)
nmap <A-k> <Action>(MoveLineUp)
imap <A-j> <Action>(MoveLineDown)
imap <A-k> <Action>(MoveLineUp)
vmap <A-j> <Action>(MoveLineDown)
vmap <A-k> <Action>(MoveLineUp)
